# === Bază de date PostgreSQL ===
POSTGRES_USER=statistic
POSTGRES_PASSWORD=statistic
POSTGRES_DB=statistic
POSTGRES_PORT=5432

# === Backend (FastAPI) ===
BACKEND_PORT=8000
# Secret pentru semnarea tokenurilor JWT. SCHIMBĂ-L în producție (ex: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
# URL-ul public al backend-ului (folosit pentru snippet pixel, linkuri scurte și QR)
BASE_URL=http://localhost:8000
# Originea din care vine dashboard-ul (pentru CORS)
FRONTEND_ORIGIN=http://localhost:5173
# Cookie Secure: true doar pe HTTPS (în producție). Local lasă false.
COOKIE_SECURE=false

# === Admin inițial (creat automat la prima pornire) ===
FIRST_ADMIN_EMAIL=admin@statistic.app
FIRST_ADMIN_PASSWORD=admin1234

# === Frontend (React) ===
FRONTEND_PORT=5173
