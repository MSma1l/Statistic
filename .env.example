# === Bază de date PostgreSQL ===
POSTGRES_USER=statistic
POSTGRES_PASSWORD=statistic
POSTGRES_DB=statistic
POSTGRES_PORT=5432

# === Backend (FastAPI) ===
BACKEND_PORT=8000
# Secret pentru semnarea tokenurilor JWT. SCHIMBĂ-L în producție (ex: openssl rand -hex 32)
JWT_SECRET=change-me-in-production
# URL-ul backend-ului (API).
BASE_URL=http://localhost:8000
# DOMENIUL PUBLIC SCURT pentru linkuri/QR/pixel. Setează-l o dată (ex:
# https://qr.domeniul-tau.ro) și NU-l mai schimba, ca QR-urile printate să rămână
# valide pe viață. Lasă-l gol ca să folosească BASE_URL.
PUBLIC_BASE_URL=
# Originea din care vine dashboard-ul (pentru CORS)
FRONTEND_ORIGIN=http://localhost:5173
# Cookie Secure: true doar pe HTTPS (în producție). Local lasă false.
COOKIE_SECURE=false

# === Admin inițial (creat automat la prima pornire) ===
FIRST_ADMIN_EMAIL=admin@statistic.app
FIRST_ADMIN_PASSWORD=admin1234

# === AI (consultant CRO + gardian GDPR) ===
# Cheia API Anthropic (Claude). SECRET — nu o pune în git. Gol => feature-ul AI e
# dezactivat grațios (restul aplicației merge normal). O setezi tu mai târziu.
ANTHROPIC_API_KEY=
# Modelul folosit (cel mai nou Claude disponibil). Prompturile și regulile GDPR se
# editează din UI (admin → „AI & GDPR"), NU de aici.
AI_MODEL=claude-opus-4-8

# === Frontend (React) ===
FRONTEND_PORT=5173
# URL-ul API folosit de dashboard la BUILD. Local: backend-ul direct (cross-origin).
# În producție (un singur domeniu + nginx dispecer) lasă-l GOL ca dashboard-ul să
# facă cereri relative `/api/...` (same-origin, fără CORS). Vezi docs/DEPLOYMENT.md.
VITE_API_URL=http://localhost:8000

# === Producție (lasă gol local) ===
# Prefix pentru a lega porturile Docker DOAR pe localhost-ul serverului, ca să fie
# accesibile doar de nginx-ul de pe host (ex: 127.0.0.1:). Local lasă gol.
BIND_HOST=
