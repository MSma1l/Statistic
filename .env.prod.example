# =============================================================================
#  PRODUCȚIE — copiază în `.env.prod` pe server și completează valorile reale.
#  Pornire:  docker compose --env-file .env.prod up -d --build
#  Ghid complet:  docs/DEPLOYMENT.md
# =============================================================================

# --- Domeniul tău (înlocuiește app.domeniul-tau.ro peste tot) -----------------
# Cât timp ești pe HTTP (înainte de certbot) folosește http://
# După ce activezi HTTPS, schimbă în https:// AICI și pune COOKIE_SECURE=true.

# === Bază de date PostgreSQL ===
POSTGRES_USER=statistic
POSTGRES_PASSWORD=SCHIMBA_parola_asta_lunga_si_random
POSTGRES_DB=statistic
# Portul intern pe server (nu e expus public; doar localhost îl vede prin BIND_HOST)
POSTGRES_PORT=5433

# === Backend (FastAPI) ===
BACKEND_PORT=8010
# OBLIGATORIU random în producție:  openssl rand -hex 32
JWT_SECRET=GENEREAZA_CU_openssl_rand_hex_32
# URL-ul public al aplicației (același domeniu pentru tot — dashboard, API, linkuri).
# Folosit de backend pentru snippet-ul pixel, linkuri scurte și QR.
BASE_URL=http://app.domeniul-tau.ro
# Domeniu PUBLIC scurt pentru QR/linkuri. Gol => folosește BASE_URL. Setează-l O
# DATĂ și nu-l mai schimba (QR-urile printate rămân valide pe viață).
PUBLIC_BASE_URL=
# Originea dashboard-ului pentru CORS. Pe un singur domeniu = BASE_URL.
FRONTEND_ORIGIN=http://app.domeniul-tau.ro
# false cât ești pe HTTP. Pune true DUPĂ ce activezi HTTPS (altfel nu te poți loga).
COOKIE_SECURE=false

# === Admin inițial (creat automat la prima pornire) ===
FIRST_ADMIN_EMAIL=admin@domeniul-tau.ro
FIRST_ADMIN_PASSWORD=SCHIMBA_parola_de_admin

# === Frontend (React) ===
FRONTEND_PORT=5180
# GOL = dashboard-ul face cereri relative `/api/...` pe ACELAȘI domeniu, rezolvate
# de nginx-ul dispecer de pe host. Nu pune nimic aici pe un singur domeniu.
VITE_API_URL=

# === Izolare porturi ===
# Leagă containerele DOAR pe localhost-ul serverului. Nginx-ul de pe host le
# accesează prin 127.0.0.1, dar nu sunt expuse direct pe internet.
BIND_HOST=127.0.0.1:
